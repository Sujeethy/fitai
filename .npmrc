# React Native's bundler (Metro) does not follow pnpm's symlinked node_modules
# layout, so peer dependencies like @expo/metro-runtime fail to resolve. Hoisting
# gives Metro the flat tree it expects. This is the standard setting for Expo in a
# pnpm monorepo.
node-linker=hoisted

# Expo's packages expect their peers to be reachable.
strict-peer-dependencies=false
